---
import Layout from '../layouts/Layout.astro';
import '../styles/marketing.css';
import '../styles/inbox.css';

import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ChatSnippet from '../components/ChatSnippet.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Pricing from '../components/Pricing.astro';
import VisitorMap from '../components/VisitorMap.astro';
import WorkspaceSwitcher from '../components/WorkspaceSwitcher.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { tiers, startUrl } from '../data/pricing';

// Rendered via set:html because the literal { } braces collide with Astro's
// expression syntax.
const mcpSnippet = `<span class="c"># .mcp.json</span>
{
  <span class="k">"banshee"</span>: {
    <span class="k">"command"</span>: "npx",
    <span class="k">"args"</span>: ["-y", "@banshee/mcp"],
    <span class="k">"env"</span>: { <span class="k">"BANSHEE_KEY"</span>: "sk_live_…" }
  }
}

<span class="c"># then, in Claude:</span>
<span class="k">›</span> "Summarize today's unanswered
   conversations across all 3 brands"`;

const founderTax = [
  { icon: 'dollar-sign', heading: 'The per-seat tax', body: 'Intercom runs multi-brand only on its Expert plan, about <b style="color:var(--foreground)">$132 / seat / month</b>. Add a brand, add a bill.' },
  { icon: 'bot', heading: 'The resolution tax', body: 'Bots answer for you at <b style="color:var(--foreground)">$0.99 per AI resolution</b>, an unpredictable bill that grows with your success.' },
  { icon: 'layers', heading: 'The workspace tax', body: 'Most tools make you spin up a separate account or workspace per product. More logins, more invoices, more chaos.' },
];

const featureGrid = [
  { icon: 'book-open', heading: 'Help center and theme studio', body: 'Searchable knowledge base on your own domain, fully themed, SEO sitemap included.' },
  { icon: 'mail', heading: 'Omnichannel', body: 'Web widget, reply-by-email, WhatsApp and SMS. Every channel lands in one thread.' },
  { icon: 'bar-chart', heading: 'Analytics suite', body: 'Response times, CSAT, heatmaps, channel mix, top countries, agent leaderboard.' },
  { icon: 'smartphone', heading: 'iOS and Android apps', body: 'Full inbox in your pocket. Get pinged, reply from anywhere.' },
  { icon: 'star', heading: 'CSAT and follow-ups', body: 'Auto satisfaction surveys and follow-up emails, branded per product.' },
  { icon: 'code', heading: 'API and MCP server', body: 'On every plan. Public REST API and an MCP server that turns support into tools for your AI agents.' },
];

const compareColumns = ['Banshee', 'Intercom', 'Crisp'];
const compareRows = [
  { label: 'Multiple brands', cells: [{ text: 'From Solo, the cheap tier', status: 'good' }, { text: 'Expert plan, about $132/seat', status: 'bad' }, { text: 'Multi-site from €45/mo', status: 'neutral' }] },
  { label: 'AI billing', cells: [{ text: 'Included, no per-resolution meter', status: 'good' }, { text: '$0.99 / AI resolution', status: 'bad' }, { text: 'Usage-based add-ons', status: 'neutral' }] },
  { label: 'Live translation', cells: [{ text: 'Two-way, base plans', status: 'good' }, { text: 'Add-on or higher tiers', status: 'neutral' }, { text: 'Limited', status: 'neutral' }] },
  { label: 'API and MCP', cells: [{ text: 'Every plan, even Free', status: 'good' }, { text: 'Higher tiers', status: 'neutral' }, { text: 'Add-on', status: 'neutral' }] },
  { label: 'Pricing shape', cells: [{ text: 'Flat, predictable', status: 'good' }, { text: 'Per-seat plus usage', status: 'bad' }, { text: 'Per-workspace', status: 'neutral' }] },
];

const translationExchange = [
  { role: 'v', text: "Bonjour, je n'arrive pas à connecter mon domaine.", tag: 'detected: French, auto-translated for you', avatar: '🇫🇷' },
  { role: 'a', text: 'Happy to help. Head to Settings, then Domains, and paste your CNAME there.', tag: 'you typed English, sent to the visitor in French' },
  { role: 'v', text: 'Parfait, merci !', avatar: '🇫🇷' },
];

const testimonials = [
  [
    { role: 'v', text: 'how does the scoring actually work?' },
    { role: 'v', text: 'oh wait, is this a person? thought it was automated 😅' },
    { role: 'v', text: "I can look it up, don't mean to waste your time!" },
    { role: 'a', text: 'haha not at all, real human here 🙂' },
  ],
  [
    { role: 'v', text: 'do you have an app?' },
    { role: 'v', text: 'oh, sorry for the blunt message, was expecting a chatbot!' },
    { role: 'a', text: 'haha no worries at all 👋 apps are on the way too' },
  ],
  [
    { role: 'v', text: 'how are points calculated?' },
    { role: 'v', text: 'scrap that, thought this was AI…' },
    { role: 'a', text: 'nope, real human 🙂 happy to walk you through it' },
  ],
  [
    { role: 'v', text: 'thanks for sorting my account before the event tomorrow, just in case this goes to a real person' },
    { role: 'a', text: "it does 🙂 I'll be there too, I'll say hi" },
  ],
];
---

<Layout title="Banshee: The support inbox for founders running multiple products">
  <Nav />

  <Hero />

  <!-- WHY IT MATTERS -->
  <Section
    center
    eyebrow="Build the right thing"
    heading="Vibe-coding ships the app. Real conversations tell you what to build."
    lead="AI can scaffold a product in a weekend. It cannot tell you what your customers actually need. Your first users can, but they will not open up to a bot. Banshee puts a real human (you) in the conversation, so every chat doubles as product research instead of a ticket deflected into the void."
  />

  <!-- PROBLEM -->
  <Section
    alt
    eyebrow="The founder tax"
    heading="You ship faster than you can answer email."
    lead="And every support tool punishes you for it: per seat, per brand, per &quot;AI resolution.&quot; Run three products and the bills stack up before you've made a dollar."
  >
    <FeatureGrid items={founderTax} cols={3} />
  </Section>

  <!-- MULTI-BRAND -->
  <Section id="multi-brand">
    <div class="split">
      <div>
        <span class="eyebrow">Multi-brand · included on Solo</span>
        <h2>Every product. One inbox.</h2>
        <p class="lead">Each brand gets its own widget, colors, logo, help center and email branding. You run them all from a single dashboard, as a team of one.</p>
        <ul class="feat-list">
          <li><span class="ck">✓</span> Per-brand widget, greeting, and topics</li>
          <li><span class="ck">✓</span> Per-brand help center on your own domain (help.yourbrand.com)</li>
          <li><span class="ck">✓</span> Per-brand email branding on transcripts and CSAT</li>
          <li><span class="ck">✓</span> Switch brands from the workspace picker, no re-login</li>
        </ul>
      </div>
      <div class="panel">
        <WorkspaceSwitcher />
      </div>
    </div>
  </Section>

  <!-- HUMAN-FIRST AI -->
  <Section alt id="human-first">
    <div class="split">
      <div class="panel">
        <ChatSnippet messages={translationExchange} />
      </div>
      <div>
        <span class="eyebrow">Human-first AI</span>
        <h2>AI does the grunt work. You do the talking.</h2>
        <p class="lead">No bot-wall. No per-resolution meter. Banshee's AI translates 100+ languages in real time, drafts replies you can accept or edit, and tidies your canned answers, so a real human still answers, just faster and in any language.</p>
        <ul class="feat-list">
          <li><span class="ck">✓</span> Two-way live translation (visitor and agent)</li>
          <li><span class="ck">✓</span> AI draft suggestions you can accept, edit, or ignore</li>
          <li><span class="ck">✓</span> Canned-answer clustering keeps shortcuts tidy</li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- HUMAN MOMENTS -->
  <Section
    center
    eyebrow="Real conversations · anonymized"
    heading="The moment they realize you're human."
    lead="Customers are so used to bot-walls that a real reply catches them off guard, the good kind. Actual messages from Banshee inboxes."
  >
    <div class="grid g2">
      {testimonials.map((messages) => <ChatSnippet messages={messages} card />)}
    </div>
    <p class="mono" style="color:var(--muted-foreground);font-size:var(--fs-xs);margin-top:16px;text-align:center">Anonymized real messages. Confirm consent before publishing.</p>
  </Section>

  <!-- VISITOR MAP -->
  <Section
    alt
    id="visitor-map"
    center
    eyebrow="Live visitor map"
    heading="See who's on your sites, right now."
    lead="Watch visitors land in real time, see what page they're on and where they're from, and start the conversation before they even say hello."
  >
    <VisitorMap />
  </Section>

  <!-- FEATURE GRID -->
  <Section
    eyebrow="Everything else, built in"
    heading="A real support platform, not a widget."
  >
    <FeatureGrid items={featureGrid} cols={3} />
  </Section>

  <!-- INTERCOM CONTRAST -->
  <Section
    alt
    id="compare"
    eyebrow="The honest comparison"
    heading="Flat and predictable. Not a per-seat surprise."
    lead="We won't quietly move you from $119 to $854 a month. (A real founder's Intercom story.)"
  >
    <ComparisonTable columns={compareColumns} rows={compareRows} />
    <p class="mono" style="color:var(--muted-foreground);font-size:var(--fs-xs);margin-top:12px">Competitor figures are public list prices, mid-2026. Banshee pricing shown qualitatively. See Pricing.</p>
  </Section>

  <!-- BUILDERS / MCP -->
  <Section id="founders">
    <div class="split">
      <div>
        <span class="eyebrow">Built for builders</span>
        <h2>Your support, as tools for your AI.</h2>
        <p class="lead">Banshee ships an MCP server, so Claude (or any agent you build) can read and answer conversations right inside your workflow. The support tool that speaks your stack's language.</p>
        <ul class="feat-list">
          <li><span class="ck">✓</span> Public REST API and webhooks</li>
          <li><span class="ck">✓</span> MCP server: conversations as agent tools</li>
          <li><span class="ck">✓</span> Included on every plan, even Free</li>
          <li><span class="ck">✓</span> One <span class="mono">&lt;script&gt;</span> tag to install the widget</li>
        </ul>
      </div>
      <div class="codeblock" set:html={mcpSnippet}></div>
    </div>
  </Section>

  <!-- PRICING -->
  <Section
    alt
    id="pricing"
    center
    eyebrow="Pricing"
    heading="Flat. Predictable. Free to start."
    lead="No per-seat tax. No per-resolution meter. Big team? We'll talk. We won't auto-bill you into next quarter."
  >
    <Pricing tiers={tiers} />
    <p class="mono" style="color:var(--muted-foreground);font-size:var(--fs-xs);margin-top:18px;text-align:center">Indicative, pricing finalizing. Very large teams: custom.</p>
  </Section>

  <!-- FINAL CTA -->
  <section class="finalcta"><div class="wrap">
    <h2>Stop screaming.<br><span class="banshee-wordmark">Start talking.</span></h2>
    <p class="lead" style="margin:18px auto 28px">Only banshees should be screaming. Add one script tag and start talking to your users in minutes, across every product you've shipped.</p>
    <a href={startUrl} class="btn btn-primary" style="font-size:var(--fs-base);padding:14px 26px">Start free</a>
  </div></section>

  <Footer />
</Layout>
