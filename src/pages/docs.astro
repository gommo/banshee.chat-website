---
import Layout from '../layouts/Layout.astro';
import '../styles/marketing.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { startUrl } from '../data/pricing';

// NOTE: docs landing scaffold. Links are placeholders until real docs exist.
const docCards = [
  { icon: 'send', heading: 'Install the widget', body: 'Add one script tag to any site and go live in minutes.' },
  { icon: 'smartphone', heading: 'Agent apps', body: 'Set up the native iOS and Android apps and push notifications.' },
  { icon: 'layers', heading: 'Multi-brand setup', body: 'Add a product, its widget, help center domain and email branding.' },
  { icon: 'book-open', heading: 'Help center', body: 'Publish articles, theme them, and host on your own domain.' },
  { icon: 'code', heading: 'REST API', body: 'Read and write conversations and contacts programmatically.' },
  { icon: 'sparkles', heading: 'MCP server', body: 'Expose your inbox as tools for Claude or your own agents.' },
];
---

<Layout
  title="Docs | Banshee.chat"
  description="Guides for installing the Banshee widget, the mobile apps, multi-brand, help center, the REST API and the MCP server."
>
  <Nav />

  <header class="hero"><div class="wrap">
    <span class="pill"><Icon name="book-open" size={15} /> Documentation</span>
    <h1 style="margin-top:18px">Everything you need to <span class="banshee-wordmark">get set up.</span></h1>
    <p class="lead">From a one-line install to the MCP server. Pick a topic to get started.</p>
  </div></header>

  <Section>
    <div class="notice" style="margin-bottom:28px">
      <span class="n-ic"><Icon name="ghost" size={18} /></span>
      <span>Full documentation is on the way. In the meantime, start free and the in-app guides will walk you through setup.</span>
    </div>
    <div class="grid g3">
      {docCards.map((d) => (
        <a href="#" class="card feature-card">
          <div class="ico"><Icon name={d.icon} size={20} /></div>
          <h3>{d.heading}</h3>
          <p>{d.body}</p>
          <span class="feature-cta">Read guide</span>
        </a>
      ))}
    </div>
  </Section>

  <section class="finalcta"><div class="wrap">
    <h2>Ready in <span class="banshee-wordmark">minutes.</span></h2>
    <p class="lead" style="margin:18px auto 28px">Add one script tag and start talking to your users. Free to start.</p>
    <a href={startUrl} class="btn btn-primary" style="font-size:var(--fs-base);padding:14px 26px">Start free</a>
  </div></section>

  <Footer />

  <style>
    .feature-card { display: flex; flex-direction: column; transition: border-color .15s, transform .15s; }
    .feature-card:hover { border-color: var(--primary); transform: translateY(-2px); }
    .feature-cta { color: var(--primary); font-size: var(--fs-sm); font-weight: 600; margin-top: 14px; }
  </style>
</Layout>
