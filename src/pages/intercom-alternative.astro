---
import Layout from '../layouts/Layout.astro';
import '../styles/marketing.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Icon from '../components/Icon.astro';

import { getComparison } from '../data/comparisons';
import { startUrl } from '../data/pricing';

const c = getComparison('intercom')!;

const tableRows = c.rows.map((row) => ({
  label: row.label,
  cells: [
    { text: row.banshee, status: 'good' as const },
    { text: row.them, status: row.themBad ? ('bad' as const) : ('neutral' as const) },
  ],
}));
---

<Layout
  title="The Intercom alternative for founders | Banshee.chat"
  description="Banshee is the flat-priced, human-first Intercom alternative for founders. No per-seat tax, no $0.99-per-resolution meter, multi-brand from the cheap tier."
>
  <Nav />

  <!-- HERO -->
  <header class="hero"><div class="wrap">
    <span class="pill"><Icon name="ghost" size={15} /> No per-seat tax. No per-resolution meter.</span>
    <h1 style="margin-top:18px">The Intercom alternative<br><span class="banshee-wordmark">built for founders.</span></h1>
    <p class="lead">{c.lead}</p>
    <div class="herocta">
      <a href={startUrl} class="btn btn-primary">Start free</a>
      <a href="/compare/intercom" class="btn btn-ghost">Full Banshee vs Intercom</a>
    </div>
  </div></header>

  <!-- PROBLEM -->
  <Section alt eyebrow={c.problemEyebrow} heading={c.problemHeading} lead={c.problemLead} />

  <!-- WHY SWITCH -->
  <Section eyebrow="The founder case" heading={c.switchHeading}>
    <FeatureGrid items={c.switchCards} cols={3} />
  </Section>

  <!-- TABLE -->
  <Section alt eyebrow="Side by side" heading="Banshee vs Intercom, feature by feature.">
    <div style="margin-top:24px">
      <ComparisonTable columns={['Banshee', 'Intercom']} rows={tableRows} />
    </div>
    <p class="mono" style="color:var(--muted-foreground);font-size:var(--fs-xs);margin-top:12px">{c.footnote}</p>
  </Section>

  <!-- FINAL CTA -->
  <section class="finalcta"><div class="wrap">
    <h2>Leave the per-seat bill behind.<br><span class="banshee-wordmark">Start free.</span></h2>
    <p class="lead" style="margin:18px auto 28px">Add one script tag and start talking to your users in minutes, across every product you have shipped.</p>
    <a href={startUrl} class="btn btn-primary" style="font-size:var(--fs-base);padding:14px 26px">Start free</a>
  </div></section>

  <Footer />
</Layout>
