---
import Layout from '../../layouts/Layout.astro';
import '../../styles/marketing.css';

import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import { startUrl } from '../../data/pricing';

// NOTE: blog index scaffold. No posts yet; wire to a content collection when
// posts exist.
---

<Layout
  title="Blog | Banshee.chat"
  description="Founder-to-founder writing on customer support, pricing and building in public."
>
  <Nav />

  <header class="hero"><div class="wrap">
    <span class="pill"><Icon name="book-open" size={15} /> Blog</span>
    <h1 style="margin-top:18px">Notes from <span class="banshee-wordmark">the inbox.</span></h1>
    <p class="lead">Founder-to-founder writing on support, pricing and building in public. First posts are on the way.</p>
  </div></header>

  <Section>
    <div class="notice" style="max-width:760px">
      <span class="n-ic"><Icon name="ghost" size={18} /></span>
      <span>No posts yet. The blog launches alongside the site. Start free in the meantime.</span>
    </div>
  </Section>

  <section class="finalcta"><div class="wrap">
    <h2>Stop screaming.<br><span class="banshee-wordmark">Start talking.</span></h2>
    <p class="lead" style="margin:18px auto 28px">Add one script tag and start talking to your users in minutes.</p>
    <a href={startUrl} class="btn btn-primary" style="font-size:var(--fs-base);padding:14px 26px">Start free</a>
  </div></section>

  <Footer />
</Layout>
