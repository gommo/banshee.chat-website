---
import Layout from '../layouts/Layout.astro';
import '../styles/marketing.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';

// NOTE: DRAFT scaffold only. This is NOT a real privacy policy. Replace with
// legally reviewed copy before publishing. Section headings are placeholders.
const sections = [
  { h: 'Overview', p: 'This page will describe what data Banshee collects, how it is used, and the choices you have. This is a working draft.' },
  { h: 'What we collect', p: 'Account details, the conversations and contacts you manage in Banshee, and basic technical data needed to run the widget.' },
  { h: 'How we use it', p: 'To provide and improve the service: routing conversations, live translation, analytics, and support.' },
  { h: 'Sharing and subprocessors', p: 'We use a small set of subprocessors to run the service. A full list will be published here and is available on request.' },
  { h: 'Retention and deletion', p: 'You can export and delete your data. Retention periods will be documented here.' },
  { h: 'Your rights', p: 'Depending on where you are, you may have rights to access, correct, or delete your data. Contact us to exercise them.' },
  { h: 'Contact', p: 'Questions about privacy? Get in touch and we will help.' },
];
---

<Layout
  title="Privacy | Banshee.chat"
  description="How Banshee handles your data. Working draft."
>
  <Nav />

  <header class="hero"><div class="wrap">
    <span class="pill"><Icon name="ghost" size={15} /> Privacy</span>
    <h1 style="margin-top:18px">Privacy <span class="banshee-wordmark">policy.</span></h1>
  </div></header>

  <Section>
    <div class="notice" style="max-width:760px;margin-bottom:32px">
      <span class="n-ic"><Icon name="ghost" size={18} /></span>
      <span>Working draft. This is placeholder content and not the final, legally reviewed privacy policy.</span>
    </div>
    <div class="prose">
      {sections.map((s) => (
        <div>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
  </Section>

  <Footer />
</Layout>
