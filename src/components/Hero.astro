---
import Icon from './Icon.astro';
import InboxDemo from './InboxDemo.astro';
import { startUrl } from '../data/pricing';

const audience = ['Microsaas', 'Indie', 'Solo founders', 'Vibe-coded apps', 'Founder-built'];
---

<header class="hero"><div class="wrap">
  <span class="pill"><Icon name="inbox" size={15} /> One place to support all your products</span>
  <h1 style="margin-top:18px">Vibe-code the product.<br><span class="banshee-wordmark">Don't vibe-code the support.</span></h1>
  <p class="lead">Be the human your customers actually reach. Banshee's AI drafts your replies and translates in real time, so supporting <b style="color:var(--foreground)">every product you ship</b> takes seconds.</p>
  <div class="herocta">
    <a href={startUrl} class="btn btn-primary">Start free</a>
    <a href="/compare/intercom" class="btn btn-ghost">See why founders leave Intercom</a>
  </div>
  <div class="scripttag">Install in one line: <b>&lt;script src="https://scream.banshee.chat/widget/boo.js"&gt;&lt;/script&gt;</b></div>

  <p class="hero-tagline">Built for founders shipping <b>more than one thing</b></p>

  <InboxDemo />

  <div class="hero-audience">
    {audience.map((a) => <span>{a}</span>)}
  </div>
</div></header>
