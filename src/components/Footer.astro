---
const year = new Date().getFullYear();
---

<footer class="site-footer"><div class="wrap">
  <div class="fcols">
    <div class="col" style="max-width:240px">
      <div class="brand" style="margin-bottom:8px"><img src="/images/logo.png" alt="Banshee" width="28" height="28" class="brand-logo" /> <span class="banshee-wordmark">Banshee.chat</span></div>
      <span style="color:var(--muted-foreground)">Customer support for founders running multiple products. Only banshees should be screaming.</span>
    </div>
    <div class="col"><b style="color:var(--foreground)">Product</b><a href="/features">All features</a><a href="/features/multi-brand">Multi-brand</a><a href="/features/translation">Live translation</a><a href="/features/visitor-map">Visitor map</a><a href="/features/api-mcp">API and MCP</a></div>
    <div class="col"><b style="color:var(--foreground)">Solutions</b><a href="/for/multi-product-founders">Multi-product founders</a><a href="/for/saas">For SaaS</a><a href="/for/agencies">For agencies</a><a href="/for/ecommerce">For ecommerce</a></div>
    <div class="col"><b style="color:var(--foreground)">Compare</b><a href="/compare/intercom">vs Intercom</a><a href="/compare/crisp">vs Crisp</a><a href="/compare/zendesk">vs Zendesk</a><a href="/compare/tawk">vs Tawk.to</a></div>
    <div class="col"><b style="color:var(--foreground)">Company</b><a href="/pricing">Pricing</a><a href="/about">About</a><a href="https://help.banshee.chat">Docs</a><a href="/changelog">Changelog</a><a href="/blog">Blog</a><a href="/security">Security</a></div>
  </div>
  <div style="margin-top:32px;border-top:1px solid var(--border);padding-top:20px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap">
    <span>© {year} Banshee.chat</span>
    <span style="display:flex;gap:18px"><a href="/privacy">Privacy</a><a href="/terms">Terms</a></span>
  </div>
</div></footer>
