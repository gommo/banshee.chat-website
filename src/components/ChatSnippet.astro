---
// Chat bubble snippet. `messages` is a list of { role: 'v' (visitor) | 'a'
// (agent), text, tag? }. When a message has a `tag`, it renders the small mono
// caption under the bubble (used by the translation exchange). Set `card` to
// wrap the thread in a card (used by the testimonial grid). Emoji are allowed
// inside chat bubbles per the brand rules.
interface Message {
  role: 'v' | 'a';
  text: string;
  tag?: string;
}

interface Props {
  messages: Message[];
  card?: boolean;
}

const { messages, card = false } = Astro.props;
---

{card ? (
  <div class="card"><div class="chat">
    {messages.map((m) => (
      m.tag
        ? <div><div class={`bub ${m.role}`}>{m.text}</div><div class="tag">{m.tag}</div></div>
        : <div class={`bub ${m.role}`}>{m.text}</div>
    ))}
  </div></div>
) : (
  <div class="chat">
    {messages.map((m) => (
      m.tag
        ? <div><div class={`bub ${m.role}`}>{m.text}</div><div class="tag">{m.tag}</div></div>
        : <div class={`bub ${m.role}`}>{m.text}</div>
    ))}
  </div>
)}
