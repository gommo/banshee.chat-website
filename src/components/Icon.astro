---
// Inline Lucide icons, rendered at build time (zero runtime JS).
// Paths match the Banshee design-system Icon.jsx: 24x24 viewBox, 2px stroke,
// currentColor. Usage: <Icon name="ghost" size={16} />
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const PATHS: Record<string, string> = {
